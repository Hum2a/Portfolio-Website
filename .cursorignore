# .cursorignore — files excluded from Cursor indexing & AI context
# Keeps indexing cheap by skipping dependencies, build output, generated
# files, lockfiles, secrets, and large binary assets.

# Dependencies
node_modules/
/.pnp
.pnp.js

# Build / production output
/build
/dist
/.wrangler
/coverage

# Lockfiles (huge, low signal)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Secrets / env
.env
.env.*
!.env.example
.dev.vars*
!.dev.vars.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor cruft
.DS_Store
.idea/
.vscode/
.codegpt/

# Binary & media assets (not useful to index)
public/images/
public/logos/
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.ico
*.mp4
*.mov
*.webm
*.woff
*.woff2
*.ttf
*.eot
*.pdf
*.zip

# Generated SEO / verification files
public/sitemap*.xml
public/sitemap-index.xml
public/robots.txt
public/BingSiteAuth.xml
public/google*.html
public/.well-known/
