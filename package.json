{
  "name": "portfolio",
  "version": "1.1.0",
  "homepage": ".",
  "private": true,
  "type": "module",
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "crypto-js": "^4.2.0",
    "firebase": "^11.4.0",
    "framer-motion": "^11.15.0",
    "hono": "^4.12.34",
    "lucide-react": "^1.28.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "uuid": "^11.1.0",
    "web-vitals": "^4.2.4",
    "zod": "^4.4.3"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "npm run images && npm run og && npm run sitemap && vite build",
    "images": "node scripts/optimize-images.mjs",
    "og": "node scripts/generate-og-images.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "preview:cf": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy --keep-vars",
    "secrets:sync": "node scripts/sync-cloudflare-secrets.mjs",
    "secrets:sync:deploy": "node scripts/sync-cloudflare-secrets.mjs --deploy",
    "build:analyze": "cross-env VERIFY_BUNDLE=1 vite build",
    "verify:lh": "node scripts/verify/lighthouse.mjs",
    "verify:axe": "node scripts/verify/axe.mjs",
    "verify:contrast": "node scripts/verify/contrast.mjs",
    "verify:prefs": "node scripts/verify/prefs.mjs",
    "verify:throttle": "node scripts/verify/throttle.mjs",
    "verify:urls": "node scripts/verify/urls.mjs",
    "verify:bundle": "node scripts/verify/bundle.mjs",
    "verify:notify": "node scripts/verify/notify.mjs",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "lint:strict": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings 0",
    "lint:projects": "eslint \"src/projects/**/*.{js,jsx,ts,tsx}\"",
    "lint:pages": "eslint \"src/pages/**/*.{js,jsx,ts,tsx}\"",
    "lint:components": "eslint \"src/components/**/*.{js,jsx,ts,tsx}\"",
    "lint:traffic": "eslint \"src/pages/Traffic/**/*.{js,jsx,ts,tsx}\" \"src/services/analyticsStatsUpdater.ts\"",
    "lint:services": "eslint \"src/services/**/*.{js,jsx,ts,tsx}\"",
    "lint:report": "eslint \"src/**/*.{js,jsx,ts,tsx}\" -f unix",
    "lint:ci": "cross-env CI=true eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings 0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "chrome-launcher": "^1.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "lighthouse": "^12.8.2",
    "playwright": "^1.62.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vite-plugin-compression": "^0.5.1",
    "wrangler": "^4.80.0"
  }
}
