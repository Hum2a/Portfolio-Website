# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id


# Analytics Settings
REACT_APP_ENABLE_ANALYTICS=true
# Optional: higher ipinfo.io limits (free tier at https://ipinfo.io/signup). Works without it via geojs.io fallback.
REACT_APP_IPINFO_TOKEN=

# Traffic email notifications (Worker → Resend)
# From: traffic@humza-butt.space | Default To: humzab1711@hotmail.com (hardcoded)
# Extra recipients managed in Traffic → Email notifications (Firestore)
# Same value as Worker secret NOTIFY_SECRET (wrangler secret put NOTIFY_SECRET)
REACT_APP_TRAFFIC_NOTIFY_SECRET=
# Also set via wrangler secret put:
#   RESEND_API_KEY, NOTIFY_SECRET