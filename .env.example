# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your_project_id
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
REACT_APP_FIREBASE_APP_ID=your_app_id

# Other API Keys
REACT_APP_IPINFO_TOKEN=

# Analytics Settings
REACT_APP_ENABLE_ANALYTICS=true

# GitHub Username
REACT_APP_GITHUB_USERNAME=

# Traffic email notifications (Worker → Resend)
# From: traffic@humza-butt.space | Default To: humzab1711@hotmail.com (hardcoded)
# Extra recipients managed in Traffic → Email notifications (Firestore)
#
# IMPORTANT: NOTIFY_SECRET must be a random shared token — NOT your Resend API key.
# REACT_APP_TRAFFIC_NOTIFY_SECRET is baked into the browser bundle at build time.
NOTIFY_SECRET=
REACT_APP_TRAFFIC_NOTIFY_SECRET=
#
# Resend API key (Worker only — never reuse as NOTIFY_SECRET / REACT_APP_*)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFY_TO_EMAIL=
#
# Sync ALL non-empty .env keys to Cloudflare Worker secrets (upsert, never deletes others):
#   npm run secrets:sync
#   npm run secrets:sync:deploy
#   npm run secrets:sync -- --dry-run
#   npm run secrets:sync -- --dev-vars
#   npm run secrets:sync -- --worker-only
#
# REACT_APP_* still need a rebuild (`npm run deploy`) to appear in production JS.
# Deploys use --keep-vars so dashboard plain-text variables are preserved.
